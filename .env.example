# Netlify environment variables for automatic email + secure admin email confirmation.
# Add these in Netlify Site configuration; do not commit real values.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BWAI <hello@your-verified-domain.com>
ALLOWED_ORIGIN=https://bwai0.netlify.app

# Firebase Admin SDK service account values for the Netlify function.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
